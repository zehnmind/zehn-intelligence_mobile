{
  "catalog": "zehn.basic.v1",
  "sdk_version": "0.7.0",
  "common": {"id": "string", "component": "string", "visible": "value", "width": "number",
             "height": "number", "flex": "number", "padding": "insets", "action": "action",
             "position": ["center", "top", "bottom", "start", "end", "top_start", "top_end", "bottom_start", "bottom_end"]},
  "field": {"field": "field", "label": "value", "hint": "value", "value": "literal", "checks": "checks"},
  "blocks": {
    "Box": {"about": "A container with a background, border, shadow, radius and padding (inside the background); the card's root, with color surface. alignment places its child inside it.",
            "group": "layout", "needs": ["child"],
            "props": {"child": "id", "color": "color", "radius": "radius", "border": "color", "shadow": "shadow",
                      "alignment": ["center", "top", "bottom", "start", "end", "top_start", "top_end", "bottom_start", "bottom_end"]}},
    "Column": {"about": "Blocks stacked top to bottom. justify spreads them when the column has a height.",
               "group": "layout", "needs": ["children"],
               "props": {"children": "children", "gap": "number", "align": ["start", "center", "end", "stretch"],
                         "justify": ["start", "center", "end", "space_between", "space_around", "space_evenly"]}},
    "Row": {"about": "Blocks side by side; scroll: true makes a sideways carousel (its padding scrolls with it). justify spreads the blocks, e.g. space_between.",
            "group": "layout", "needs": ["children"],
            "props": {"children": "children", "gap": "number", "align": ["start", "center", "end", "stretch"],
                      "justify": ["start", "center", "end", "space_between", "space_around", "space_evenly"],
                      "scroll": "bool"}},
    "Image": {"about": "A network image from an https URL; full width unless width is set. fit cover (default) crops it to fill, fill stretches it, contain shows all of it.",
              "group": "content", "needs": ["src"],
              "props": {"src": "value", "radius": "radius", "fit": ["cover", "fill", "contain"]}},
    "Text": {"about": "A line or paragraph of text. style picks a theme text style; size, weight, lineHeight, letterSpacing and font override it for this text. spans (instead of text) colours parts of it.",
             "group": "content", "needs": [["text", "spans"]],
             "props": {"text": "value", "spans": "spans", "style": "text_style", "color": "color", "maxLines": "number",
                       "size": {"type": "number", "min": 6, "max": 96}, "weight": {"type": "number", "min": 100, "max": 900},
                       "lineHeight": {"type": "number", "min": 0.8, "max": 3}, "letterSpacing": {"type": "number", "min": -0.2, "max": 0.5},
                       "font": "string", "textAlign": ["start", "center", "end"]}},
    "Icon": {"about": "One icon: a built-in one or one the app registered, drawn at size in color (default muted).",
             "group": "content", "needs": ["name"],
             "props": {"name": "icon_name", "size": {"type": "number", "min": 8, "max": 96}, "color": "color"}},
    "Chip": {"about": "A small rounded label: floor, rating, category.",
             "group": "content", "needs": ["text"],
             "props": {"text": "value", "icon": "icon", "color": "color"}},
    "Header": {"about": "A section title with an icon tile; a chevron when it has an action.",
               "group": "content", "needs": ["title"],
               "props": {"title": "value", "icon": "icon"}},
    "InfoRow": {"about": "An icon and one line of text with a divider under it: hours, phone, website.",
                "group": "content", "needs": ["text"],
                "props": {"text": "value", "icon": "icon"}},
    "Button": {"about": "A full-width button; primary uses accent, secondary uses chip.",
               "group": "content", "needs": ["label"],
               "props": {"label": "value", "icon": "icon", "variant": ["primary", "secondary"]}},
    "Divider": {"about": "A thin line in the border colour, between parts of a card; padding gives it room around.",
                "group": "content", "needs": [],
                "props": {}},
    "Stack": {"about": "Blocks on top of each other, the first at the back. alignment places them, and a block's own position lays that block over the others: a label or a badge on an image.",
              "group": "layout", "needs": ["children"],
              "props": {"children": "children",
                        "alignment": ["center", "top", "bottom", "start", "end", "top_start", "top_end", "bottom_start", "bottom_end"]}},
    "Wrap": {"about": "Blocks left to right that flow onto the next line when the row is full: chips, tags. gap is the space between blocks, runGap between lines.",
             "group": "layout", "needs": ["children"],
             "props": {"children": "children", "gap": "number", "runGap": "number", "align": ["start", "center", "end"]}},
    "Progress": {"about": "A rounded bar filled from 0 to 1: how far along something is.",
                 "group": "content", "needs": ["value"],
                 "props": {"value": "value", "color": "color", "track": "color", "height": {"type": "number", "min": 2, "max": 40}}},
    "Avatar": {"about": "A round image of a person or a brand; with no image, the first two letters of text on a colour.",
               "group": "content", "needs": [],
               "props": {"src": "value", "text": "value", "size": {"type": "number", "min": 16, "max": 160}, "color": "color"}},
    "TextField": {"about": "A box to type into, in a form card: one line, several lines, a number, an email address or a phone number. What is typed is at /form/<field>.",
                  "group": "field", "needs": ["field", "label"],
                  "props": {"input": ["text", "multiline", "number", "email", "phone"], "placeholder": "value",
                            "maxLength": {"type": "number", "min": 1, "max": 4000}}},
    "Checkbox": {"about": "A box to tick, in a form card: true or false.",
                 "group": "field", "needs": ["field", "label"], "props": {}},
    "Switch": {"about": "An on and off switch, in a form card: true or false.",
               "group": "field", "needs": ["field", "label"], "props": {}},
    "Select": {"about": "One or several of a fixed list of options, in a form card, as a dropdown, rows or chips.",
               "group": "field", "needs": ["field", "label", "options"],
               "props": {"options": "options", "multiple": "bool", "look": ["dropdown", "list", "chips"], "placeholder": "value"}},
    "DateField": {"about": "A date picked from a calendar, in a form card, as YYYY-MM-DD.",
                  "group": "field", "needs": ["field", "label"],
                  "props": {"min": "date", "max": "date"}}
  },
  "icons": ["theaters", "layers", "schedule", "phone", "language", "movie", "ticket", "map",
            "parking", "star", "info", "car", "store", "calendar", "wallet", "person", "restaurant",
            "bus", "gift", "forward"],
  "actions": {"open_route": ["route"], "ask": ["text"], "open_url": ["url"], "submit": []},
  "text_styles": ["display", "title", "body", "caption"],
  "colors": ["surface", "on_surface", "muted", "chip", "image_bg", "border", "accent", "on_accent", "error"],
  "radii": ["card", "image", "chip", "button"],
  "formats": ["time", "date", "datetime", "number", "money", "duration"],
  "checks": {"required": {"on": ["TextField", "Checkbox", "Switch", "Select", "DateField"], "args": []},
             "length":   {"on": ["TextField"], "args": ["min", "max"]},
             "range":    {"on": ["TextField"], "args": ["min", "max"]},
             "items":    {"on": ["Select"], "args": ["min", "max"]}},
  "since": {"zehn.basic.v1": {"blocks": ["Stack", "Wrap", "Progress", "Avatar", "TextField", "Checkbox", "Switch", "Select", "DateField"],
                              "common": ["position"], "actions": ["submit"], "values": ["equals"]}},
  "words": {
    "required": {"uz": "Bu maydonni to‘ldiring", "ru": "Заполните это поле", "en": "Fill this in"},
    "length": {"uz": "{min} tadan {max} tagacha belgi kiriting", "ru": "От {min} до {max} символов", "en": "Use {min} to {max} characters"},
    "length_min": {"uz": "Kamida {min} ta belgi kiriting", "ru": "Не меньше {min} символов", "en": "Use at least {min} characters"},
    "length_max": {"uz": "Ko‘pi bilan {max} ta belgi kiriting", "ru": "Не больше {max} символов", "en": "Use at most {max} characters"},
    "range": {"uz": "{min} dan {max} gacha son kiriting", "ru": "Введите число от {min} до {max}", "en": "Enter a number from {min} to {max}"},
    "range_min": {"uz": "{min} yoki undan katta son kiriting", "ru": "Введите {min} или больше", "en": "Enter {min} or more"},
    "range_max": {"uz": "{max} yoki undan kichik son kiriting", "ru": "Введите {max} или меньше", "en": "Enter {max} or less"},
    "items": {"uz": "{min} tadan {max} tagacha tanlang", "ru": "Выберите от {min} до {max}", "en": "Choose {min} to {max}"},
    "items_min": {"uz": "Kamida {min} tasini tanlang", "ru": "Выберите не меньше {min}", "en": "Choose at least {min}"},
    "items_max": {"uz": "Ko‘pi bilan {max} tasini tanlang", "ru": "Выберите не больше {max}", "en": "Choose at most {max}"},
    "number": {"uz": "Son kiriting", "ru": "Введите число", "en": "Enter a number"},
    "email": {"uz": "Elektron pochta manzilini kiriting", "ru": "Введите адрес почты", "en": "Enter an email address"},
    "phone": {"uz": "Telefon raqamini kiriting", "ru": "Введите номер телефона", "en": "Enter a phone number"},
    "date": {"uz": "Boshqa sanani tanlang", "ru": "Выберите другую дату", "en": "Choose another date"},
    "option": {"uz": "Variantlardan birini tanlang", "ru": "Выберите один из вариантов", "en": "Choose one of the options"},
    "sent": {"uz": "Yuborildi", "ru": "Отправлено", "en": "Sent"},
    "not_answered": {"uz": "Javob berilmadi", "ru": "Без ответа", "en": "Not answered"},
    "not_sent": {"uz": "Yuborilmadi. Qayta urinib ko‘ring.", "ru": "Не отправлено. Попробуйте ещё раз.", "en": "Not sent. Try again."},
    "update_app": {"uz": "Javob berish uchun ilovani yangilang.", "ru": "Обновите приложение, чтобы ответить.", "en": "Update the app to answer this."},
    "choose": {"uz": "Tanlang", "ru": "Выбрать", "en": "Choose"}
  }
}
